{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "start": "pnpm run build && pnpm run backend",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",

    "backend": "node backend/scripts/orchestrator.mjs",
    "backend:dev": "NODE_ENV=development WATCH_SOURCE=true node backend/scripts/orchestrator.mjs",
    "backend:reload": "bash backend/ops/reload.sh",
    "backend:legacy": "tsx scripts/start-backend.mts",
    "backend:stop": "pm2 stop hakase-ai-service hakase-api-server",
    "backend:logs": "pm2 logs",
    "backend:status": "pm2 status",

    "frontend": "tsx scripts/start-frontend.mts",
    "frontend:dev": "tsx scripts/start-frontend.mts dev",
    "frontend:build": "tsx scripts/start-frontend.mts build",

    "api-server": "cd artifacts/api-server && pnpm run dev",
    "ai-service": "cd artifacts/ai-service && python main.py"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "tsx": "catalog:",
    "typescript": "~5.9.2"
  }
}
