# /etc/systemd/system/hakase-frontend.service
#
# Install / enable:
#   sudo cp frontend/systemd/hakase-frontend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hakase-frontend
#   sudo systemctl reload hakase-frontend   # zero-downtime, after git pull
[Unit]
Description=Hakase BioTwin — Frontend (Vite preview)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hakase
Group=hakase
WorkingDirectory=/opt/hakase/Hakase-BioTwin-dev
Environment=NODE_ENV=production
EnvironmentFile=-/opt/hakase/Hakase-BioTwin-dev/frontend/.env
ExecStartPre=/usr/bin/node /opt/hakase/Hakase-BioTwin-dev/frontend/scripts/preflight.mjs
ExecStart=/usr/bin/node /opt/hakase/Hakase-BioTwin-dev/frontend/scripts/start.mjs
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hakase-frontend

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
