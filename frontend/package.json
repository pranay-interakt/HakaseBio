{
  "name": "@hakase/frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Hakase BioTwin frontend deploy unit — Vite/React SPA.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "install:all": "node scripts/install.mjs",
    "build": "node scripts/build.mjs",
    "start": "NODE_ENV=production node scripts/start.mjs",
    "start:dev": "NODE_ENV=development node scripts/start.mjs",
    "preview": "node scripts/preview.mjs",
    "pm2:start": "pm2 start config/ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 reload config/ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop config/ecosystem.config.cjs",
    "pm2:logs": "pm2 logs --lines 200",
    "pm2:status": "pm2 status",
    "deploy": "bash ops/deploy.sh",
    "deploy:reload": "bash ops/reload.sh",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "pm2": "^5.4.3"
  }
}
