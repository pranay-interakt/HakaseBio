# ============================================================
# Hakase BioTwin — Frontend env (PRODUCTION-GRADE)
# Copy to .env and fill in. NEVER commit .env to git.
# Vite reads VITE_* prefixed vars at build time.
# ============================================================

NODE_ENV=production

# ── Server (vite preview / dev) ──────────────────────────────
PORT=4000
HOST=0.0.0.0
BASE_PATH=/

# ── Backend base URL — public origin of the backend deploy unit ─
VITE_API_BASE_URL=https://api.example.com
VITE_AI_SERVICE_URL=https://api.example.com/ai

# ── Build flags ──────────────────────────────────────────────
VITE_APP_ENV=production
VITE_BUILD_VERSION=
VITE_ENABLE_DEMO=false

# ── Auto-reload after git pulls ──────────────────────────────
AUTO_RELOAD_ON_PULL=true
RELOAD_STRATEGY=pm2          # pm2 | systemd | nginx-static
