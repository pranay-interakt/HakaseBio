# ============================================================
# Hakase BioTwin — Backend env (PRODUCTION-GRADE)
# Copy to .env and fill in. NEVER commit .env to git.
# ============================================================

# ── Process / runtime ─────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ── Service ports ────────────────────────────────────────────
PORT=3000                         # Express API server (public)
AI_SERVICE_PORT=8090              # FastAPI AI service (internal, behind same host)
AI_SERVICE_URL=http://127.0.0.1:8090

# ── Repository root (auto-detected if blank) ─────────────────
REPO_ROOT=

# ── GPU provider selection ───────────────────────────────────
# local | runpod | aws | azure
GPU_PROVIDER=runpod

# ── Anthropic (Claude) ───────────────────────────────────────
# Required for bio-chat + report-narrative routes.
# Use the literal string DUMMY (or leave blank) to BYPASS Anthropic
# calls during development — the backend will return a canned
# placeholder narrative instead of calling Claude.
ANTHROPIC_API_KEY=DUMMY
ANTHROPIC_MODEL=claude-opus-4-5
ANTHROPIC_BYPASS=auto             # auto | force | off
                                  #   auto  -> bypass if key missing/DUMMY
                                  #   force -> always return dummy
                                  #   off   -> always call Claude (fail loud)

# ── RunPod (Layer-2 GPU jobs) ────────────────────────────────
# Use DUMMY to bypass RunPod for dev. Real Layer-2 jobs will be
# satisfied by deterministic placeholders compatible with the
# downstream IVIVE schemas for all modalities.
RUNPOD_API_KEY=DUMMY
RUNPOD_FEP_ENDPOINT_ID=DUMMY
RUNPOD_BOLTZ_ENDPOINT_ID=DUMMY
RUNPOD_BYPASS=auto                # auto | force | off

# ── External APIs (optional) ─────────────────────────────────
EPA_CCTE_API_KEY=

# ── Auto-reload after git pulls (post-merge hook target) ─────
AUTO_RELOAD_ON_PULL=true
RELOAD_STRATEGY=pm2               # pm2 | systemd

# ── CORS (frontend origin) ───────────────────────────────────
FRONTEND_ORIGIN=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com,http://localhost:4000

# ── Storage / data dir ───────────────────────────────────────
HAKASE_DATA_DIR=/var/lib/hakase

# ── Healthcheck (used by deploy.sh + CI) ─────────────────────
HEALTHCHECK_TIMEOUT_MS=15000
HEALTHCHECK_PATH=/api/health
