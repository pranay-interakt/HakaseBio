# Copy to .env (never commit .env). Generate each secret, e.g.: openssl rand -hex 32
# Use hex or other URL-safe characters: the database password is placed in a URL.
POSTGRES_PASSWORD=
# Entered once on the sign-in page to create the first administrator.
HOS_BOOTSTRAP_TOKEN=
# Authenticates the ledger checkpoints (docs/07 7.6). Keep it outside the database's backups.
HOS_ANCHOR_KEY=
# Published port of the web app (put TLS in front of it).
HOS_HTTP_PORT=8080
HOS_API_WORKERS=2
# Where alerts go (audit-trail integrity failures): a paging service or chat webhook URL.
HOS_ALERT_WEBHOOK=
# How often the integrity service checks the whole record.
HOS_INTEGRITY_INTERVAL_SECONDS=3600
