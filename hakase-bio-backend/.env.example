# ============================================================
# Hakase BioTwin — environment variable reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. The server fails LOUD if anything required is missing.
# ============================================================


# ────────────────────────────────────────────────────────────
# SERVICE PORTS  (required on every host)
# ────────────────────────────────────────────────────────────

PORT=3000               # Express API server
AI_SERVICE_PORT=8090    # FastAPI AI service
AI_SERVICE_URL=http://localhost:8090   # How the API server reaches the AI service
                                       # Change to a real URL when they run on different machines
NODE_ENV=development                   # production | development | test
APP_URL=http://localhost:3000          # Canonical public URL (CORS + OAuth redirect URIs + cookie domain)
TRUST_PROXY=false                      # true behind nginx / fly.io / cloud LB
ENABLE_CSP=true                        # set false only to debug CSP issues


# ────────────────────────────────────────────────────────────
# DATABASE
# ────────────────────────────────────────────────────────────
# Postgres connection string. Used for user accounts, sessions, audit log,
# IP allow/block lists, and OAuth state.
DATABASE_URL=postgresql://USER@localhost:5432/hakase_bio


# ────────────────────────────────────────────────────────────
# AUTH SECRETS  (required)
# ────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -base64 48
# Rotate independently; sessions survive cookie-secret rotation only if you
# keep the old value in COOKIE_SECRETS_PREVIOUS (optional, future-only).
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_base64_48
COOKIE_SECRET=CHANGE_ME_openssl_rand_base64_48
CSRF_SECRET=CHANGE_ME_openssl_rand_base64_48

# Access-token TTL (sec). Refresh = 30 days by default.
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# Brute-force lockout
ACCOUNT_LOCK_THRESHOLD=8           # failed logins before account temp-lock
ACCOUNT_LOCK_WINDOW_MIN=15         # lock duration in minutes

# Rate limits (per minute, per IP)
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=120


# ────────────────────────────────────────────────────────────
# EMAIL  (Resend — required for email verify + password reset)
# ────────────────────────────────────────────────────────────
# Get a key at https://resend.com → API Keys
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM="Hakase BioTwin <no-reply@hakase.ai>"


# ────────────────────────────────────────────────────────────
# OAUTH — Google
# ────────────────────────────────────────────────────────────
# https://console.cloud.google.com → Credentials → OAuth client ID (Web)
# Authorized redirect URI MUST be:
#     ${APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ────────────────────────────────────────────────────────────
# OAUTH — Apple ("Sign in with Apple")
# ────────────────────────────────────────────────────────────
# https://developer.apple.com → Services ID + Sign in with Apple key
# Authorized redirect URI MUST be:
#     ${APP_URL}/api/auth/oauth/apple/callback
APPLE_CLIENT_ID=                 # your Services ID, e.g. ai.hakase.signin
APPLE_TEAM_ID=                   # 10-char team ID
APPLE_KEY_ID=                    # 10-char key ID from the .p8
APPLE_PRIVATE_KEY=               # PEM contents on one line with literal \n for newlines


# ────────────────────────────────────────────────────────────
# GPU PROVIDER SELECTION
# ────────────────────────────────────────────────────────────
# Choose ONE provider for GPU-intensive jobs (Boltz-2 co-folding, FEP/TIES).
#
#   GPU_PROVIDER=local     — Run directly on this machine's GPU (RunPod Pod,
#                            DigitalOcean GPU Droplet, any Linux GPU server).
#                            No API keys needed. pnpm backend installs all deps.
#                            THIS IS THE RECOMMENDED OPTION for a RunPod Pod.
#
#   GPU_PROVIDER=runpod    — RunPod Serverless (separate worker endpoint via API)
#   GPU_PROVIDER=aws       — AWS SageMaker Async Inference
#   GPU_PROVIDER=azure     — Azure ML Managed Online Endpoint

GPU_PROVIDER=local


# ────────────────────────────────────────────────────────────
# PROVIDER: RunPod  (GPU_PROVIDER=runpod)
# ────────────────────────────────────────────────────────────
#
# 1. Create a RunPod account → https://runpod.io
# 2. Go to API Keys → create a key → paste below
# 3. Deploy your worker Docker image as a Serverless endpoint (runpod_worker/)
#    → Serverless → New Endpoint → choose your image → get the Endpoint ID
# 4. Do this once for FEP and once for Boltz-2 (or reuse one image if it handles both)

RUNPOD_API_KEY=your_runpod_api_key_here

# Endpoint ID for the TIES/FEP worker (L2 Stage 5)
RUNPOD_FEP_ENDPOINT_ID=your_fep_endpoint_id_here

# Endpoint ID for the Boltz-2 co-folding worker (L2 Stage 2b)
RUNPOD_BOLTZ_ENDPOINT_ID=your_boltz_endpoint_id_here


# ────────────────────────────────────────────────────────────
# PROVIDER: AWS  (GPU_PROVIDER=aws)
# ────────────────────────────────────────────────────────────
#
# Uses SageMaker Async Inference — closest equivalent to RunPod Serverless.
# Jobs are submitted via the SageMaker API; input/output travel through S3.
#
# Setup steps:
# 1. Create an IAM user with SageMaker + S3 permissions → get access keys
# 2. Create an S3 bucket in the same region for job I/O
# 3. Build and push your worker Docker image to Amazon ECR
# 4. Create a SageMaker Model pointing to your ECR image
# 5. Create an Async Inference endpoint config + endpoint for each worker
# 6. Fill in the endpoint NAMES (not URLs) below
#
# Install boto3: pip install boto3

AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# S3 bucket for async job inputs and outputs (must be in the same region)
AWS_SAGEMAKER_OUTPUT_BUCKET=your-hakase-gpu-jobs-bucket

# SageMaker async endpoint NAME for the FEP worker
AWS_SAGEMAKER_FEP_ENDPOINT=hakase-fep-endpoint

# SageMaker async endpoint NAME for the Boltz-2 worker
AWS_SAGEMAKER_BOLTZ_ENDPOINT=hakase-boltz-endpoint


# ────────────────────────────────────────────────────────────
# PROVIDER: Azure ML  (GPU_PROVIDER=azure)
# ────────────────────────────────────────────────────────────
#
# Uses Azure ML Managed Online Endpoints.
# Your worker container must implement the same async job pattern as the
# RunPod worker: POST → {"job_id": "..."} immediately, GET /status/{id} to poll.
# This means the same Docker image works on both RunPod and Azure.
#
# Setup steps:
# 1. Create an Azure ML workspace
# 2. Push your worker image to Azure Container Registry (ACR)
# 3. Create a Managed Online Endpoint for each worker in Azure ML Studio
# 4. Deploy your image to the endpoint
# 5. Go to Endpoints → Consume → copy the Scoring URI and primary key below

# API key (primary or secondary key from the endpoint's Consume tab)
AZURE_ML_API_KEY=your_azure_ml_api_key

# Full scoring URI for the FEP worker endpoint
# Format: https://<endpoint-name>.<region>.inference.ml.azure.com/score
AZURE_ML_FEP_ENDPOINT_URL=https://hakase-fep.eastus.inference.ml.azure.com/score

# Full scoring URI for the Boltz-2 worker endpoint
AZURE_ML_BOLTZ_ENDPOINT_URL=https://hakase-boltz.eastus.inference.ml.azure.com/score

# Deployment name within the endpoint (optional, defaults to "default")
# AZURE_ML_DEPLOYMENT_NAME=default


# ────────────────────────────────────────────────────────────
# EXTERNAL API KEYS  (not GPU-related)
# ────────────────────────────────────────────────────────────

# EPA CCTE API key — for toxicity data via the CCTE route
EPA_CCTE_API_KEY=your_epa_ccte_api_key

# Anthropic API key — used by bio-chat and report-narrative routes
ANTHROPIC_API_KEY=your_anthropic_api_key


# ────────────────────────────────────────────────────────────
# STORAGE  (optional)
# ────────────────────────────────────────────────────────────

# Directory for co-folding job SQLite database (defaults to current dir)
# HAKASE_DATA_DIR=/var/data/hakase


# ────────────────────────────────────────────────────────────
# REMOTE REFERENCE DATA  (optional; large atlases kept out of the clone)
# ────────────────────────────────────────────────────────────
# Big reference artifacts are NOT committed. They are fetched once at runtime
# from an object-store URL into the ephemeral cache (see runtime/remote_data.py).
# If a URL is unset the corresponding projection degrades gracefully to a
# "data-not-provisioned" state — it never fabricates data.
#
# DepMap PRISM snapshot — powers the L3 Stage-4 patient-line projection.
# DEPMAP_PARQUET_URL=https://<your-object-store>/depmap_prism_aggregated.parquet
#
# Tabula Sapiens v2 atlas — powers cell-type aggregation (Drug2cell). The
# "behavioural fingerprinting" UI surface is withheld for now, so this is only
# needed by direct callers of /predict/celltype-aggregation.
# TABULA_SAPIENS_PARQUET_URL=https://<your-object-store>/tabula_sapiens_aggregated.parquet


# ────────────────────────────────────────────────────────────
# ERSILIA MODEL HUB CONFIGURATION (Optional - L1 cytotoxicity)
# ────────────────────────────────────────────────────────────
# Set to 'local' to enable local docker-based Ersilia model serving, 'client' for remote, or 'off'
HAKASE_ERSILIA_MODE=off
# JSON mapping of endpoints to Ersilia catalog model IDs
HAKASE_ERSILIA_MODELS='{"cytotoxicity":"eos9ei3"}'
# JSON mapping of expected output formats
HAKASE_ERSILIA_OUTPUT='{"cytotoxicity":{"kind":"cc50_uM","key":"cc50"}}'

# ────────────────────────────────────────────────────────────
# STRICT ML ENGINE LOADING (Production enforcement)
# ────────────────────────────────────────────────────────────
# Set to '1' to enforce strict loading of ML models (ADMET-AI, CardioTox, DILI-ML, etc.).
# When STRICT_ML=1, the application refuses to start up or warm up if model weights
# cannot be loaded or executed, preventing silent fallback to heuristics. Default is '0'.
STRICT_ML=0
