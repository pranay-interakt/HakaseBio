# ── Git LFS ──────────────────────────────────────────────────────────────────
# Large binaries are stored as LFS pointers so the repo stays small. Note this
# only affects commits made *after* the rule is added; converting the existing
# history requires `git lfs migrate import`, which rewrites commit SHAs and so
# needs team coordination (see RESTRUCTURE.md §12).

# ADMET Chemprop ensemble weights (~1.3 MB each, 10 files).
*.pt filter=lfs diff=lfs merge=lfs -text

# Large reference corpora shipped with the vendored ADMET engine. Scoped to the
# vendor directory so the small TDC validation CSVs stay as normal blobs.
modalities/small-molecule/engine/src/hakase_smallmol/vendor/hakase_admet/resources/data/*.csv filter=lfs diff=lfs merge=lfs -text

# The one oversized docking fixture (2.3 MB); the other five are small enough to
# stay as normal blobs so they remain diffable.
platform/structure/fixtures/pdb/5IKR.pdb filter=lfs diff=lfs merge=lfs -text

# ── Line endings ─────────────────────────────────────────────────────────────
# PDB and TDC .tab are fixed-width, column-position-sensitive formats. Never
# normalise them — see .pre-commit-config.yaml, which also excludes them from
# the whitespace-stripping hooks after those hooks silently corrupted all six
# docking fixtures (RESTRUCTURE.md F13).
*.pdb -text
*.tab -text
