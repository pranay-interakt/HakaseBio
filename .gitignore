# Replit
.cache/
.local/
tdc_data/
data/
# Re-include the DrugCentral local-data directory so its README + .gitignore
# (which document the CC BY-SA handling policy and exclude only the raw TSV)
# stay tracked. Per gitignore semantics we must not ignore the parent dir
# itself before re-including children.
!artifacts/hakase-ai/data/
!artifacts/hakase-ai/data/drugcentral/
!artifacts/hakase-ai/data/drugcentral/README.md
!artifacts/hakase-ai/data/drugcentral/.gitignore
!artifacts/ai-service/data/

# Environment configurations
.env
.env.*
!.env.example

# Python compiled output and runtime cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ipynb_checkpoints/
artifacts/ai-service/cache/*.pkl
artifacts/ai-service/cache/*.npz

