run = "bash start.sh"
entrypoint = "start.sh"
modules = ["python-3.11:v18-20230807-322e88b", "nodejs-20:v8-20230920-bd784b9"]

hidden = [".config", "**/__pycache__", "**/.git"]

[nix]
channel = "stable-24_05"

[env]
PORT = "3000"
AI_SERVICE_PORT = "8090"
AI_SERVICE_URL = "http://localhost:8090"
NODE_ENV = "development"
PYTHONUNBUFFERED = "1"
HAKASE_SKIP_PREWARM = "1"
STRICT_ML = "0"
HAKASE_ERSILIA_MODE = "off"

[deployment]
run = ["bash", "start.sh"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 4176
externalPort = 80

[[ports]]
localPort = 8090
externalPort = 8090
